# =============================================================================
# Trip Flow — 環境變數範例
# 複製為 .env 後填入實際值（.env 不納入 git）
# =============================================================================

# --- 必須（全站共用）---

NOTION_TOKEN=secret_xxx
NOTION_TRIPS_DATABASE_ID=xxx
NOTION_USERS_DATABASE_ID=xxx

JWT_SECRET=change-me-to-a-long-random-string

# --- 伺服器 ---

PORT=3001

# --- 身份驗證（可選，有預設值）---

JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
AUTH_PROVIDER=notion

# --- 旅行設定 fallback（可選）---
# 各旅行的 flow / 資訊頁 / 日期應優先寫在 Notion Trips database。
# 以下僅在 DB 欄位為空、或仍使用舊版 /api/itinerary、/api/pages/:key 時作為後備。

# NOTION_FLOW_DATABASE_ID=xxx
# TRIP_START_DATE=2026-07-16
# TRIP_END_DATE=2026-07-23
# NOTION_FLIGHT_PAGE_ID=xxx
# NOTION_ACCOMMODATION_PAGE_ID=xxx
# NOTION_TICKET_PAGE_ID=xxx

# --- Flow database 欄位覆寫（可選）---
# 各 trip 的 flow schema 若一致，可在此統一指定；否則依自動偵測。

# NOTION_FLOW_TITLE_PROPERTY=名稱
# NOTION_FLOW_NEXT_PROPERTY=Next
# NOTION_FLOW_PREVIOUS_PROPERTY=Previous
# NOTION_FLOW_DATE_PROPERTY=日期
# NOTION_FLOW_DETAILS_PROPERTY=行程 page

# --- 渲染與快取調校（可選，有預設值）---

# NOTION_BLOCKS_MAX_RENDER=12
# NOTION_BLOCKS_MAX_FETCH=60
# NOTION_MAX_CARDS=50
# ITINERARY_CACHE_MAX_AGE=86400
# ITINERARY_FINGERPRINT_TTL=3600
# NOTION_PAGE_BLOCKS_MAX=200
# NOTION_PAGE_CACHE_MAX_AGE=3600
